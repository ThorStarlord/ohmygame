{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "thorstarlord/renpy",
  "version": "0.2.0",
  "engines": {
    "ohmygame-api": "^2.37.0"
  },
  "displayName": "%displayName%",
  "description": "%description%",
  "longDescription": "%longDescription%",
  "icon": "./assets/icon.svg",
  "categories": [
    "engine"
  ],
  "beta": true,
  "activation": {
    "files": [
      "game/options.rpy",
      "game/script.rpy"
    ]
  },
  "appliesTo": [
    "general",
    "thorstarlord/renpy:renpy-game"
  ],
  "entrypoints": {
    "native": "./native/index.mjs"
  },
  "capabilities": {
    "native": true
  },
  "configuration": {
    "renpySdkPath": {
      "type": "path",
      "title": "%config.renpySdkPath%",
      "description": "%config.renpySdkPath.description%",
      "default": ""
    }
  },
  "contributes": {
    "projectTypes": [
      {
        "id": "renpy-game",
        "title": "%type.title%",
        "description": "%type.description%",
        "icon": "./assets/icon.svg",
        "template": "./templates/renpy-game",
        "recognize": {
          "files": [
            "game/options.rpy"
          ]
        },
        "preview": "web-build",
        "playtest": "web"
      }
    ],
    "skills": "./skills/",
    "tools": [
      {
        "name": "renpy_status",
        "description": "Locate the Ren'Py SDK used for this project and report its command-line executable.",
        "input": "./tools/empty.json",
        "output": "./tools/status-output.json"
      },
      {
        "name": "renpy_lint",
        "description": "Run the Ren'Py script linter with --error-code and return its diagnostics.",
        "input": "./tools/empty.json",
        "output": "./tools/run-output.json",
        "timeoutSeconds": 180
      },
      {
        "name": "renpy_compile",
        "description": "Compile Ren'Py scripts in a disposable mirror with the installed SDK, promote changed .rpyc files for save compatibility, and keep player saves untouched.",
        "input": "./tools/empty.json",
        "output": "./tools/run-output.json",
        "timeoutSeconds": 180
      },
      {
        "name": "renpy_test",
        "description": "Run the project's enabled Ren'Py testcases with the installed SDK. Without a selection this is the engine's default global suite.",
        "input": "./tools/empty.json",
        "output": "./tools/run-output.json",
        "timeoutSeconds": 300
      },
      {
        "name": "renpy_scenarios",
        "description": "Ask the loaded Ren'Py engine which project testcases and testsuites it registered. Runs a generated discovery testcase in the disposable validation mirror; it does not run gameplay or write project screenshots.",
        "input": "./tools/empty.json",
        "output": "./tools/scenario-list-output.json",
        "timeoutSeconds": 360
      },
      {
        "name": "renpy_scenario_run",
        "description": "Run one project-defined Ren'Py testcase or testsuite in a disposable mirror and return its outcome and engine-rendered screenshot checkpoints. Exploratory mode saves fresh checkpoints. Regression mode compares against the project's existing tests/screenshots and reports mismatches without changing them.",
        "input": "./tools/scenario-input.json",
        "output": "./tools/scenario-output.json",
        "timeoutSeconds": 360
      },
      {
        "name": "renpy_export_web",
        "description": "Build a Ren'Py Web distribution from a disposable mirror into the game's OhMyGame preview folder.",
        "input": "./tools/empty.json",
        "output": "./tools/run-output.json",
        "timeoutSeconds": 600
      }
    ],
    "commands": [
      {
        "id": "run-in-renpy",
        "title": "%command.run%",
        "run": {
          "native": "runInRenpy",
          "changesFiles": false
        },
        "slots": [
          {
            "slot": "project.toolbar",
            "when": "project.plugin('thorstarlord/renpy')"
          },
          {
            "slot": "game.start"
          }
        ]
      },
      {
        "id": "settings-status",
        "title": "%command.status%",
        "run": {
          "native": "settingsStatus",
          "changesFiles": false
        }
      },
      {
        "id": "lint-renpy",
        "title": "%command.lint%",
        "run": {
          "native": "lintRenpy",
          "changesFiles": false,
          "timeoutSeconds": 180
        },
        "slots": [
          {
            "slot": "game.more",
            "when": "project.plugin('thorstarlord/renpy')"
          }
        ]
      }
    ],
    "settings": {
      "groups": [
        {
          "rows": [
            {
              "field": "renpySdkPath"
            },
            {
              "widget": "status"
            }
          ]
        }
      ]
    }
  }
}
