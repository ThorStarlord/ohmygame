{
  "type": "object",
  "properties": {
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output": {
      "type": "string"
    },
    "validationCopy": {
      "type": "boolean"
    },
    "compiledArtifacts": {
      "type": "integer",
      "minimum": 0
    },
    "cleanupWarning": {
      "type": "string"
    },
    "outputTruncated": {
      "type": "boolean"
    },
    "diagnosticsTruncated": {
      "type": "boolean"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning",
              "info",
              "unknown"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "exitCode",
    "errors",
    "output"
  ],
  "additionalProperties": false
}
